+bool
+ArpCache::Entry::IsReprobeDue(Time interval) const
+{
+    NS_LOG_FUNCTION(this << interval);
+    if (interval <= Time(0))
+    {
+        return false;
+    }
+    return (Simulator::Now() - m_lastSeen) >= interval;
+}
