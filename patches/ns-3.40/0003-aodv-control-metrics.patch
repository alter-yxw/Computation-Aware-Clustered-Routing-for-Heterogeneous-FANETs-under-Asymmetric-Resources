+
+void
+RoutingProtocol::CollectLinkMetrics()
+{
+  
+  Time now = Simulator::Now();
+  
+  Ipv4Address myAddr = m_ipv4->GetAddress(1, 0).GetLocal();  
+
+  const auto& neighbors = m_nb.GetNeighbors();
+  for (const auto& neighbor : neighbors)
+  {
+    Ipv4Address neighborAddr = neighbor.m_neighborAddress;
+    
+    // Create an ordered address pair (avoid double-counting a bidirectional link)
+    std::pair<Ipv4Address, Ipv4Address> linkPair;
+    if (myAddr < neighborAddr)  {   linkPair = std::make_pair(myAddr, neighborAddr);  }
+    else {   linkPair = std::make_pair(neighborAddr, myAddr);  }
+    
+    // Check whether the link is already in the history
+    if (m_linkHistory.find(linkPair) == m_linkHistory.end())
+    {
+      // New link: record the creation time
+      LinkInfo info;
+      info.sourceAddr = linkPair.first;
+      info.targetAddr = linkPair.second;
+      info.creationTime = now;
+      info.lastSeenTime = now;
+      info.isAlive = true;
+      
+      m_linkHistory[linkPair] = info;
+    }
+    else
+    {
+      // Existing link: update the last-seen time
+      m_linkHistory[linkPair].lastSeenTime = now;
+      m_linkHistory[linkPair].isAlive = true;
+    }
+  }
+  
+  // Detect link breakage using AllowedHelloLoss * HelloInterval as the timeout
+  Time linkTimeout = Time(m_allowedHelloLoss * m_helloInterval);
+  
+  for (auto& link : m_linkHistory)
+  {
+    if (link.second.isAlive && (now - link.second.lastSeenTime) > linkTimeout)
+    {
+      // Link is dead
+      link.second.isAlive = false;
+      
+      double lifetime = (link.second.lastSeenTime - link.second.creationTime).GetSeconds();
+      m_linkLifetimes.push_back(lifetime);
+      
+    }
+  }
+  
+  // Reschedule the next collection (5 s)
+  m_linkMetricsEvent = Simulator::Schedule(Seconds(5.0),  &RoutingProtocol::CollectLinkMetrics,  this);
+}
+
+
+double
+RoutingProtocol::GetAverageLinkLifetime() const
+{
+  
+  if (m_linkLifetimes.empty())
+  {
+    NS_LOG_WARN("No link lifetime data available");
+    return 0.0;
+  }
+  
+  double sum = 0.0;
+  for (double lifetime : m_linkLifetimes) {  sum += lifetime; }
+  
+  double average = sum / m_linkLifetimes.size();
+  NS_LOG_DEBUG("Average link lifetime: " << average << "s, Total links broken: " << m_linkLifetimes.size());
+  
+  return average;
+}
+
+double 
+RoutingProtocol::GetControlThroughout() const
+{
+    double thp = 0.0;
+    RreqHeader    rreq;
+    RrepHeader    rrep;
+    RrepAckHeader ack;
+    RerrHeader    rerr;
+    double result = (double)rreq.GetSerializedSize() * m_rreqCounter
+                  + (double)rrep.GetSerializedSize() *(m_rrepCounter + m_helloCounter)
+                  + (double)ack.GetSerializedSize()  * m_rrepAckCounter
+                  + (double)rerr.GetSerializedSize() * m_rerrCounter;
+    thp = result / 1000;
+    return thp;
+}
