+
+void
+RoutingProtocol::CollectLinkLifetimeMetrics()
+{
+    Time now = Simulator::Now();
+    const LinkSet& links = m_state.GetLinks();
+    
+    for (const auto& link : links)
+    {
+        std::pair<Ipv4Address, Ipv4Address> linkPair =
+            std::make_pair(link.localIfaceAddr, link.neighborIfaceAddr);
+
+        if (m_linkMetrics.find(linkPair) == m_linkMetrics.end())
+        {
+            LinkMetricInfo info;
+            info.creationTime = now;
+            info.lastSeenTime = now;
+            info.symLinkStartTime = Time(0);
+            info.symLinkEndTime = Time(0);
+            info.isSymmetric = (link.symTime > now);
+            info.isAlive = true;
+            if (info.isSymmetric) info.symLinkStartTime = now;
+            m_linkMetrics[linkPair] = info;
+        }
+        else
+        {
+            LinkMetricInfo& info = m_linkMetrics[linkPair];
+            info.lastSeenTime = now;
+            bool currentlySymmetric = (link.symTime > now);
+            if (currentlySymmetric && !info.isSymmetric)
+            {
+                info.isSymmetric = true;
+                info.symLinkStartTime = now;
+            }
+            else if (!currentlySymmetric && info.isSymmetric)
+            {
+                info.isSymmetric = false;
+                info.symLinkEndTime = now;
+                if (info.symLinkStartTime > Time(0))
+                {
+                    double symDuration = (info.symLinkEndTime - info.symLinkStartTime).GetSeconds();
+                    m_symLinkDurations.push_back(symDuration);
+                }
+            }
+        }
+    }
+
+    for (auto& metric : m_linkMetrics)
+    {
+        Time timeout = Seconds(3.0 * m_helloInterval.GetSeconds());
+        if (metric.second.isAlive && (now - metric.second.lastSeenTime) > timeout)
+        {
+            metric.second.isAlive = false;
+            double lifetime = (metric.second.lastSeenTime - metric.second.creationTime).GetSeconds();
+            m_linkLifetimes.push_back(lifetime);
+            if (metric.second.isSymmetric && metric.second.symLinkStartTime > Time(0))
+            {
+                metric.second.symLinkEndTime = metric.second.lastSeenTime;
+                double symDuration = (metric.second.symLinkEndTime - metric.second.symLinkStartTime).GetSeconds();
+                m_symLinkDurations.push_back(symDuration);
+            }
+        }
+    }
+}
+
+double
+RoutingProtocol::GetAverageLinkLifetime() const
+{
+    if (m_linkLifetimes.empty()) return 0.0;
+    double sum = 0.0;
+    for (double lifetime : m_linkLifetimes) sum += lifetime;
+    return sum / m_linkLifetimes.size();
+}
+
+
+double
+RoutingProtocol::GetControlThroughput() const
+{
+    double thp = 0.0;
+    thp = m_ControllPacketSize / 1000;
+    return thp;
+}
+
+
+
+double
+RoutingProtocol::GetAverageLinkSymmetricDuration() const
+{
+    if (m_symLinkDurations.empty()) return 0.0;
+    double sum = 0.0;
+    for (double duration : m_symLinkDurations) sum += duration;
+    return sum / m_symLinkDurations.size();
+}
+
+uint32_t
+RoutingProtocol::GetTotalDeadLinks() const
+{
+    return m_linkLifetimes.size();
+}
+
+uint32_t
+RoutingProtocol::GetTotalSymLinkDurations() const
+{
+    return m_symLinkDurations.size();
+}
+
+void
+RoutingProtocol::PrintLinkLifetimeStats(const std::string& filename) const
+{
+    std::ofstream ofs(filename, std::ios::app);
+    if (!ofs.is_open()) return;
+    ofs << "Node " << m_mainAddress << ": dead_links=" << m_linkLifetimes.size()
+        << " avg_lifetime=" << GetAverageLinkLifetime() << "s"
+        << " sym_durations=" << m_symLinkDurations.size()
+        << " avg_sym=" << GetAverageLinkSymmetricDuration() << "s\n";
+    ofs.close();
+}
